<div class="card bg-base-100 w-full max-w-sm shadow-sm hover:shadow-lg transition-shadow duration-200">
  <figure class="h-48 overflow-hidden">
    <img
      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
      src="https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp"
      alt="Product image" />
  </figure>

  <div class="p-4">
    <h3 class="text-lg font-semibold mb-1">Card Title</h3>
    <p class="text-sm text-gray-600 mb-3">Short product description that gives a quick idea of the item.</p>


    <div class="flex justify-end">
      <button class="btn btn-primary btn-sm flex-1">Add to cart</button>
    </div>
  </div>
</div>